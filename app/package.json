{
    "name": "babuscales",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "dev:tauri": "cross-env VITE_DATA_ADAPTER=tauri npm run dev",
        "build:tauri": "cross-env VITE_DATA_ADAPTER=tauri npm run build",
        "typecheck": "tsc -b",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint .",
        "lint:errors": "eslint . --quiet",
        "lint:strict": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "imports:write": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "size:report": "node scripts/checkFileBudgets.mjs",
        "scan:secrets": "secretlint \"**/*\""
    },
    "dependencies": {
        "@tauri-apps/api": "^2.11.1",
        "@types/qrcode-generator": "^0.0.16",
        "qrcode-generator": "^2.0.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "ulid": "^3.0.2",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
        "@tauri-apps/cli": "^2.2.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/node": "^22.10.7",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/coverage-v8": "^4.1.10",
        "cross-env": "^10.1.0",
        "eslint": "^9.18.0",
        "eslint-import-resolver-typescript": "^3.7.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.18",
        "eslint-plugin-sonarjs": "^4.0.2",
        "globals": "^17.9.0",
        "jsdom": "^27.0.1",
        "prettier": "^3.4.2",
        "secretlint": "^13.0.4",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0",
        "vite": "^6.0.7",
        "vitest": "^4.1.10"
    }
}
