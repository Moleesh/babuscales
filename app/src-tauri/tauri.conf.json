{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "BabuScales",
    "version": "0.1.0",
    "identifier": "com.babulens.babuscales",
    "build": {
        "beforeDevCommand": "npm run dev:tauri",
        "beforeBuildCommand": "npm run build:tauri",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "BabuScales",
                "width": 1280,
                "height": 800,
                "resizable": false,
                "maximizable": false,
                "minimizable": true,
                "closable": true,
                "alwaysOnTop": true,
                "decorations": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["msi", "nsis"],
        "publisher": "Babulens",
        "copyright": "Copyright © Babulens",
        "category": "Business",
        "shortDescription": "Weighbridge management software.",
        "longDescription": "BabuScales — weighbridge management software that a quarry can actually run. Ticketing, masters, reports, printing and hardware integration, offline-first with no cloud dependency.",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "webviewInstallMode": {
                "type": "offlineInstaller"
            },
            "nsis": {
                "installMode": "perMachine",
                "languages": ["English"],
                "displayLanguageSelector": false
            }
        }
    }
}
