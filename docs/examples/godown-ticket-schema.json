{
  "SchemaId": "godown-ticket",
  "Segments": [
    {
      "Segment": "CurrentTicket",
      "Fields": [
        { "FieldId": "VehicleNo", "Kind": "Search", "Master": "Vehicle" },
        { "FieldId": "TicketDate", "Kind": "Date", "ReadOnly": true },
        { "FieldId": "Party", "Kind": "Search", "Master": "Party" },
        { "FieldId": "Material", "Kind": "Search", "Master": "Material" },
        { "FieldId": "Transporter", "Kind": "Search", "Master": "Transporter" },
        { "FieldId": "DriverMobile", "Kind": "Text", "Label": { "en": "Driver, Mobile" } },
        { "FieldId": "NoOfBags", "Kind": "Number", "Label": { "en": "No of Bags" } },
        { "FieldId": "BagWeight", "Kind": "Number", "Label": { "en": "Bag Weight" } },
        { "FieldId": "FullBagWeight", "Kind": "Number", "Label": { "en": "Full Bag Weight" } },
        { "FieldId": "Adjust", "Kind": "Number", "Label": { "en": "Adjust" } }
      ]
    },
    {
      "Segment": "CapturedCalculated",
      "Fields": [
        { "FieldId": "Gross", "Kind": "Number", "Captured": "Gross", "Calculated": true },
        { "FieldId": "Tare", "Kind": "Number", "Captured": "Tare", "Calculated": true },
        { "FieldId": "Net", "Kind": "Formula", "Formula": "Abs(Gross - Tare)", "Calculated": true },

        {
          "FieldId": "NetAfterBags",
          "Kind": "Formula",
          "Formula": "Round(Net - (NoOfBags * BagWeight))",
          "Label": { "en": "Net After Bags" },
          "Calculated": true,
          "Group": "Intermediate"
        },
        {
          "FieldId": "EstimatedWeight",
          "Kind": "Formula",
          "Formula": "Round(FullBagWeight * NoOfBags)",
          "Label": { "en": "Estimated Weight" },
          "Calculated": true,
          "Group": "Intermediate"
        },
        {
          "FieldId": "ExcessShortage",
          "Kind": "Formula",
          "Formula": "NetAfterBags - EstimatedWeight",
          "Label": { "en": "Excess / Shortage" },
          "Calculated": true,
          "Group": "Intermediate"
        },
        {
          "FieldId": "TotalAdjustment",
          "Kind": "Formula",
          "Formula": "Round(If(ExcessShortage > 0, Adjust - ExcessShortage, 0) / 10, 0) * 10",
          "Label": { "en": "Total Adjustment" },
          "Calculated": true,
          "Group": "Intermediate"
        },
        {
          "FieldId": "GodownGross",
          "Kind": "Formula",
          "Formula": "Gross + TotalAdjustment",
          "Label": { "en": "Godown Gross" },
          "Calculated": true,
          "Group": "Final"
        },
        {
          "FieldId": "GodownNet",
          "Kind": "Formula",
          "Formula": "Net + TotalAdjustment",
          "Label": { "en": "Godown Net" },
          "Calculated": true,
          "Group": "Final"
        }
      ]
    }
  ],
  "Masters": [
    {
      "Kind": "Party",
      "Columns": [
        { "FieldId": "Email", "Kind": "Text" },
        { "FieldId": "Phone", "Kind": "Text" },
        { "FieldId": "Notes", "Kind": "Note" }
      ]
    },
    {
      "Kind": "Material",
      "Columns": [
        { "FieldId": "Rate", "Kind": "Money" },
        { "FieldId": "FullBagWeight", "Kind": "Number", "Label": { "en": "Full Bag Weight" } },
        { "FieldId": "Notes", "Kind": "Note" }
      ]
    },
    { "Kind": "Vehicle", "Columns": [{ "FieldId": "Notes", "Kind": "Note" }] },
    { "Kind": "VehicleType", "Columns": [{ "FieldId": "Notes", "Kind": "Note" }] },
    { "Kind": "Transporter", "Columns": [{ "FieldId": "Notes", "Kind": "Note" }] },
    { "Kind": "Place", "Columns": [{ "FieldId": "Notes", "Kind": "Note" }] },
    { "Kind": "Operator", "Columns": [{ "FieldId": "Notes", "Kind": "Note" }] }
  ]
}
